# Speclens Database Configuration
# Copy to .env and adjust for your environment.

# PostgreSQL connection string (neon.tech, local PostgreSQL, or any compatible service)
# Format: postgresql://user:password@host:port/database
# Never commit real credentials to the repository.
DATABASE_URL=postgresql://username:password@localhost:5432/speclens_dev

# Embedding model dimension configuration
# This determines the vector dimension for pgvector columns.
# Embedding model dimension (must match pgvector column dimension)
# Common values: 384 (MiniLM), 768, 1024, 1536, 3072, 4096
# Update this when the final embedding model is selected.
DIMENSION=384

# Environment
NODE_ENV=development

# Storage configuration
# The storage provider used by SpecLens.
# Supported values: "local" (development), "s3" (production)
STORAGE_PROVIDER=local

# When STORAGE_PROVIDER=s3, these are required:
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# When STORAGE_PROVIDER=local, the root directory for file storage.
# Defaults to ./storage relative to the project root.
STORAGE_ROOT_DIR=./storage